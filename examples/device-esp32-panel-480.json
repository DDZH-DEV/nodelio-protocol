{
  "schema_version": 1,
  "protocol_version": 1,
  "platform": "esp32-panel",
  "profile": "esp32-panel-480",
  "capabilities": [
    "content.text",
    "content.list",
    "content.music_list",
    "content.news_list",
    "content.weather",
    "content.error",
    "action.invoke",
    "net.http_via_server",
    "input.touch",
    "input.voice",
    "display.color"
  ],
  "disabled": ["media.play_local", "action.play"],
  "surfaces": ["card", "home_tile", "notification", "voice_reply"],
  "limits": {
    "max_content_bytes": 4096,
    "max_list_items": 8,
    "image": { "allowed": true, "max_edge_px": 480, "formats": ["jpeg", "png"] }
  }
}
