{
  "schema_version": 1,
  "protocol_version": 1,
  "platform": "android",
  "capabilities": [
    "content.text",
    "content.list",
    "content.image",
    "content.image_gallery",
    "content.music",
    "content.music_list",
    "content.news",
    "content.news_list",
    "content.weather",
    "content.action",
    "content.error",
    "action.invoke",
    "action.play",
    "action.pause",
    "action.next",
    "action.prev",
    "action.open_url",
    "action.handoff",
    "net.http_via_server",
    "input.touch",
    "input.voice",
    "display.color",
    "media.play_local",
    "media.play_handoff"
  ],
  "surfaces": ["card", "fullscreen", "notification", "now_playing", "voice_reply"],
  "limits": {
    "max_content_bytes": 262144,
    "max_list_items": 50,
    "image": { "allowed": true, "max_edge_px": 2048, "formats": ["jpeg", "png", "webp"] },
    "media": {
      "formats": ["audio/mpeg", "audio/mp4", "audio/aac", "audio/ogg"],
      "max_bitrate_kbps": 320,
      "concurrent_with_voice_session": true,
      "fetch": "http_via_server"
    }
  }
}
