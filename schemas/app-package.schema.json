{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DDZH-DEV/nodelio-protocol/main/schemas/app-package.schema.json",
  "title": "AppPackage",
  "description": "单个应用的权威描述。语义见 02-app-package.md。additionalProperties=true：未知字段必须忽略（04 §8.2、07 §6）。config_schema / input_schema 允许的 JSON Schema 子集见 02 §2.1。",
  "type": "object",
  "required": [
    "schema_version",
    "app_id",
    "version",
    "name",
    "min_protocol",
    "requires",
    "invoke"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z0-9][a-z0-9]*(-[a-z0-9]+)*)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "semver；build 元数据（+xxx）在包上禁止使用，比较无意义（01 §1.1）。"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 512 },
    "icon_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "publisher": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "format": "uri" },
        "contact": { "type": "string", "maxLength": 256 }
      }
    },
    "categories": {
      "type": "array",
      "items": { "anyOf": [ { "$ref": "vocabulary.schema.json#/$defs/category_v1" }, { "type": "string", "minLength": 1, "maxLength": 32 } ] }
    },
    "min_protocol": { "type": "integer", "minimum": 1 },
    "requires": {
      "type": "array",
      "items": { "$ref": "vocabulary.schema.json#/$defs/wellformed_name" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "形状约束；准入分类见 00 §3.9（display.* 等物理事实禁止放入，Host 校验层拒绝）。"
    },
    "optional": {
      "type": "array",
      "items": { "$ref": "vocabulary.schema.json#/$defs/wellformed_name" },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "surfaces.schema.json" },
      "uniqueItems": true
    },
    "fallback": {
      "type": "object",
      "additionalProperties": true,
      "required": ["card_type"],
      "properties": {
        "card_type": {
          "anyOf": [
            { "$ref": "vocabulary.schema.json#/$defs/card_type_v1" },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          ]
        }
      }
    },
    "config_schema": { "$ref": "json-schema-subset.schema.json" },
    "input_schema": { "$ref": "json-schema-subset.schema.json" },
    "invoke": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "enum": ["POST", "GET"] },
        "url": {
          "type": "string",
          "description": "Upstream invoke URL; public https required (see 04 §8.1). Relative paths only when same-origin with Host. Private-network http is a Host-side dev-mode relaxation, not expressed in this schema."
        },
        "timeout_ms": { "type": "integer", "minimum": 500, "maximum": 30000 },
        "result_types": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "vocabulary.schema.json#/$defs/card_type_v1" },
              { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            ]
          },
          "uniqueItems": true
        },
        "default_display": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "card_type": {
              "anyOf": [
                { "$ref": "vocabulary.schema.json#/$defs/card_type_v1" },
                { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              ]
            },
            "preferred_surface": { "$ref": "surfaces.schema.json" },
            "density": { "type": "string", "enum": ["compact", "normal", "rich"] },
            "prefer_image": { "type": "boolean" },
            "max_items": { "type": "integer", "minimum": 1 },
            "ttl_sec": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "expose_mcp": { "type": "boolean" },
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 512 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "entry_title": { "type": "string", "maxLength": 12 },
        "entry_icon": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
