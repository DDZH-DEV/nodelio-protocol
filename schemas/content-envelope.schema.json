{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DDZH-DEV/nodelio-protocol/main/schemas/content-envelope.schema.json",
  "title": "ContentEnvelope",
  "description": "invoke / 推送的统一结果信封。语义与错误规则见 03-content.md（§3 错误唯一表达、§5 降级矩阵）。additionalProperties=true：未知字段忽略；枚举仅提示用途，运行时按 §5 降级，未知值不拒收（07 §5.1、00 §3.8）。",
  "type": "object",
  "required": ["schema_version", "app_id", "status"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "由发起方生成、原样回带（04 §4）。"
    },
    "app_id": {
      "type": "string",
      "description": "产生本结果的应用 app_id。实例路由真相在 Host/端侧记录里（01 §6.1），本字段用于展示与关联。"
    },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "truncated": { "type": "boolean", "description": "Host 按 limits 硬截断时置 true（04 §8.2）。" },
    "truncated_locally": { "type": "boolean", "description": "可选：端本地再裁剪时自标，不回传上游。" },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "anyOf": [
              { "$ref": "vocabulary.schema.json#/$defs/content_type_v1" },
              { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            ],
            "description": "未知但形状合法的类型：按 03 §5 降级，不得丢弃整份信封。"
          },
          "id": { "type": "string", "maxLength": 128 },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "text": { "type": "string" },
          "markdown": { "type": "boolean" },
          "url": { "type": "string", "format": "uri" },
          "image_url": { "type": "string", "format": "uri" },
          "article_url": { "type": "string", "format": "uri" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "alt": { "type": "string" },
          "mime": { "type": "string" },
          "playable": { "type": "boolean", "description": "可选 Host 提示；不能替代 playback.expires_at 判断。" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "playback": {
            "type": "object",
            "additionalProperties": true,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "mime": { "type": "string" },
              "expires_at": {
                "type": "number",
                "minimum": 0,
                "description": "Unix 时间戳，单位「秒」（不是 RFC3339、不是毫秒）。03 §2.4 硬性语义。"
              },
              "expired": { "type": "boolean", "description": "可选：Host 过期剥离后的提示，非权威。" }
            }
          },
          "actions": {
            "type": "array",
            "items": { "$ref": "#/$defs/action" }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": true,
      "required": ["card_type"],
      "properties": {
        "card_type": {
          "anyOf": [
            { "$ref": "vocabulary.schema.json#/$defs/card_type_v1" },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          ],
          "description": "主渲染器选择。未知值走 03 §5 降级矩阵。"
        },
        "title": { "type": "string" },
        "preferred_surface": { "$ref": "surfaces.schema.json" },
        "density": { "type": "string", "enum": ["compact", "normal", "rich"] },
        "prefer_image": { "type": "boolean" },
        "auto_play": {
          "type": "boolean",
          "description": "可选：结果到达后是否自动播放首选条目。缺省视为 false（端不得自行默认自动播）。仅当端已声明任一 media.play_* 才有意义。见 05 §3。"
        },
        "max_items": { "type": "integer", "minimum": 1 },
        "ttl_sec": { "type": "integer", "minimum": 0 }
      }
    },
    "spoken": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code"],
      "properties": {
        "code": {
          "anyOf": [
            { "$ref": "vocabulary.schema.json#/$defs/error_code_v1" },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          ],
          "description": "标准码表见 03 §3.3；未知码端按通用错误展示，禁止丢弃信封。"
        },
        "message": {
          "type": "string",
          "maxLength": 512,
          "description": "面向人的短句。禁止含密钥、鉴权头、内部堆栈、他人设备 ID。"
        },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "required": ["content", "display"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "run"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 64 },
        "run": {
          "anyOf": [
            { "type": "string", "enum": ["invoke", "local", "handoff"] },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          ],
          "description": "未知 run：端忽略该 action（03 §4），禁止当脚本执行。"
        },
        "local": {
          "anyOf": [
            { "$ref": "vocabulary.schema.json#/$defs/local_action_v1" },
            { "$ref": "vocabulary.schema.json#/$defs/wellformed_name" }
          ]
        },
        "invoke": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "instance_id": { "type": "string", "maxLength": 128, "description": "首选：端已装清单的实例 ID（03 §3.2）。" },
            "app_id": { "type": "string", "maxLength": 128, "description": "兼容写法；多实例命中不确定时必须报 ambiguous_target。" },
            "params": { "type": "object" }
          }
        },
        "handoff": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": {
              "anyOf": [
                { "$ref": "vocabulary.schema.json#/$defs/handoff_kind_v1" },
                { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              ]
            },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "requires": {
          "type": "array",
          "items": { "$ref": "vocabulary.schema.json#/$defs/wellformed_name" },
          "uniqueItems": true
        }
      }
    }
  }
}
